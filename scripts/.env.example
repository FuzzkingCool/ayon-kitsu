# Copy to ../.env (repo root) and fill in values.
# Scripts in scripts/ auto-load ../.env on startup.

AYON_SERVER_URL=http://localhost:5000
AYON_API_KEY=

KITSU_SERVER=https://kitsu.studio.com
# Login email: KITSU_LOGIN is read first; KITSU_EMAIL is a fallback for older setups.
KITSU_LOGIN=admin@studio.com
# KITSU_EMAIL=
KITSU_PWD=password
